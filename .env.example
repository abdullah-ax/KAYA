# Copy to .env. Placeholders only. No paid service is needed.

# Local model server (Ollama)
OLLAMA_URL=http://ollama:11434
# Models are picked per run in the app (qwen3:8b or gpt-oss:20b); see config.yaml.
EMBED_MODEL=nomic-embed-text

# Web search (local SearXNG container, no key)
# Required. Set any long random string, for example the output of: openssl rand -hex 32
SEARXNG_SECRET=replace-with-a-long-random-string
SEARXNG_URL=http://searxng:8080

# Voice (local, open source)
STT_MODEL=small
TTS_ENGINE=kokoro

# App
API_URL=http://api:8000
RUNS_DIR=/app/runs
MODE=demo

# Web API (api/app.py)
# Seconds a request waits for the next founder step before it returns "working".
API_WAIT_SECONDS=30
# Optional free-tier OpenAI-style provider. The key is sent per request in the
# X-Model-Key header from the web UI; it is never saved. Leave these blank to use Ollama.
OPENAI_BASE_URL=
OPENAI_MODEL=
