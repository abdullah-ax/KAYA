# Copy to .env. Placeholders only. No paid service is needed.

# Local model server (Ollama)
OLLAMA_URL=http://ollama:11434
MODEL_DEFAULT=gpt-oss:20b
MODEL_FALLBACK=qwen3:8b
EMBED_MODEL=nomic-embed-text

# Web search (local SearXNG container, no key)
SEARXNG_URL=http://searxng:8080

# Voice (local, open source)
STT_MODEL=small
TTS_ENGINE=kokoro

# App
API_URL=http://api:8000
RUNS_DIR=/app/runs
MODE=demo
